# Copy to .env.local for local dev. On Vercel, add the same 4 variables in
# Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys
# Publishable key (sb_publishable_...) — or the legacy "anon" key. Safe in the browser; used only for live sync.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...) — or the legacy "service_role" key. SERVER ONLY. Never commit, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string. Vercel Cron sends it to /api/cron/cleanup.
CRON_SECRET=change-me-to-a-long-random-string
